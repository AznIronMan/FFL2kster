{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tower of Legends",
  "version": "1.4.0",
  "identifier": "llc.cnb.fftol",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tower of Legends — Legend II",
        "width": 800,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "FFTOL engine for Legend II (bring your own ROM)",
    "longDescription": "Tower of Legends plays Legend II from the player's own ROM, imported on this device. The app ships no game content.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
