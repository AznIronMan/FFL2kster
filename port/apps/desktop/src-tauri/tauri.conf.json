{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tower of Legends",
  "version": "1.62.0",
  "identifier": "llc.cnb.fftol",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tower of Legends",
        "width": 800,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "FFTOL engine for Legend I, II and III (bring your own ROMs)",
    "longDescription": "Tower of Legends plays Legend I, II and III from the player's own ROMs, imported on this device. The app ships no game content.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CNB",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
