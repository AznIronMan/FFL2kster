# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local secrets, private notes, and internal tracking
.private/
.tasks/
*.env
.env
.env.*
!.env.example

# Exported game data (regenerate locally with `python -m ffl2kster export-all`)
data/

# ROMs, saves, and save states (never commit game data)
input/*.gb
input/*.gbc
input/*.sav
input/reference/*
!input/reference/.gitkeep
*.gb
*.gbc
*.sgb
*.sav
*.srm
*.state
*.ss[0-9]
*.zip
*.7z
*.rar

# SQLite transient files
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Raw ROM extracts (regenerate with the committed extraction tools)
*.raw
build/extract/

# Generated build output (keep folder placeholders only)
build/*
!build/test-artifacts/
build/test-artifacts/*
!build/test-artifacts/.gitkeep

# Reverse-engineering scratch (raw dumps live here)
project/scratch/*
!project/scratch/.gitkeep

# Logs and runtime output
logs/
*.log
*.pid

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# vitest/vite config bundles left behind when temp files cannot be removed
*.timestamp-*.mjs

# FFL1kster local outputs
ffl1/build/
ffl1/scratch/

# Legend III (FFL3kster) local outputs (ROM-derived)
ffl3/build/
ffl3/scratch/
